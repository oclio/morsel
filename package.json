{
  "name": "turbo-lib",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "test:mutate": "turbo run test:mutate",
    "test:unit": "turbo run test:unit",
    "test:focus": "node scripts/test-focus.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "check:all": "turbo run check:all && pnpm lint:fix && pnpm knip && pnpm check:secrets && pnpm check:spell && pnpm check:md && true",
    "check:build": "turbo run check:build",
    "check:fast": "turbo run check:fast",
    "check:md": "markdownlint '**/*.md' --fix --ignore **/node_modules/** --ignore **/dist/**",
    "check:one": "turbo run check:one",
    "check:secrets": "gitleaks protect --staged --verbose",
    "check:size": "turbo run check:size",
    "check:spell": "cspell '**/*.{ts,md,json,yml,yaml}' --no-progress --gitignore",
    "check:types": "turbo run check:types",
    "knip": "knip --config knip.config.mjs",
    "prepare": "husky",
    "commit": "cz"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.2.0",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.2",
    "cspell": "^10.0.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "gitleaks": "^1.0.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "6.0.3"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ],
    "*.md": [
      "markdownlint --fix --ignore CHANGELOG.md"
    ],
    "*.{ts,json,md,yml,yaml}": [
      "prettier --write",
      "cspell --no-must-find-files"
    ]
  }
}
