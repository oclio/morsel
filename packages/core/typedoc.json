{
  "entryPoints": ["src/index.ts"],
  "out": "docs/api",
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "none",
  "entryFileName": "index",
  "githubPages": false,
  "excludePrivate": true,
  "excludeInternal": true,
  "hideBreadcrumbs": true,
  "hidePageTitle": true,
  "sanitizeComments": true,
  "useHTMLEncodedBrackets": true
}
