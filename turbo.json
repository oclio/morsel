{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check:all": {
      "dependsOn": ["check:fast", "build", "check:build", "check:size"]
    },
    "check:build": {
      "dependsOn": ["build"]
    },
    "check:fast": {
      "dependsOn": ["check:types", "lint:fix", "test:coverage"]
    },
    "check:one": {
      "dependsOn": ["^build"]
    },
    "check:size": {
      "dependsOn": ["build"]
    },
    "check:types": {
      "dependsOn": ["^check:types", "^build"]
    },
    "format": {},
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"]
    },
    "test:mutate": {
      "dependsOn": ["test", "^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    }
  }
}
